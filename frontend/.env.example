# Base URL for the FastAPI backend, including the /api/v1 prefix.
# Copy this file to .env and adjust for your environment.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# The /dashboard endpoint's contract isn't confirmed yet (see
# src/services/dashboardService.js). While true (or unset), the Dashboard
# page shows clearly-labeled sample data instead of calling the API.
# Set to "false" once the real endpoint exists.
VITE_USE_DASHBOARD_PLACEHOLDER=true
