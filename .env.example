# ============================================================
# Personal Finance Manager — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# The .env file is listed in .gitignore and must NEVER be committed.
#
#   cp .env.example .env
#

# --- Application ---
APP_NAME=Personal Finance Manager
DEBUG=False

# --- Database ---
# SQLite (development default — stored in a local file)
DATABASE_URL=sqlite:///./finance.db

# PostgreSQL (uncomment and fill in when switching)
# DATABASE_URL=postgresql://user:password@localhost:5432/finance_db

# --- Security ---
# Generate a strong random key for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-production-use

# JWT token expiry in minutes (default: 60 minutes × 24 hours = 1 day)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
