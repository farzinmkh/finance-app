# Production Environment Variables for Finance App
# 
# SECURITY WARNING:
# This is a TEMPLATE ONLY. Never commit the actual .env file to git.
# Use this template as a guide to create .env on the production server.
#
# Deployment instructions:
#   1. Copy this file to /opt/finance_app/.env on production server
#   2. Edit each value with real production secrets
#   3. Set permissions: chmod 600 /opt/finance_app/.env
#   4. Owned by finance_app user: chown finance_app:finance_app /opt/finance_app/.env
#   5. Never commit the actual .env file

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://finance_user:SecurePassword123!@db.example.com:5432/finance_db
DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# JWT signing secret key (MUST be random and SECURE)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MINIMUM 32 characters, use special characters, numbers, uppercase/lowercase
SECRET_KEY=[GENERATE_NEW_RANDOM_KEY_HERE]

# Access token expiry in minutes (recommended: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Environment: production, staging, or development
ENVIRONMENT=production

# Application host/port (for Gunicorn binding)
APP_HOST=127.0.0.1
APP_PORT=8000

# Domain name (used for CORS, links in emails if added later)
DOMAIN=finance.example.com

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: JSON or text
LOG_FORMAT=JSON

# ============================================================================
# EXTERNAL SERVICES (OPTIONAL)
# ============================================================================
# Sentry error tracking
# Get from: https://sentry.io (free tier: 10,000 errors/month)
SENTRY_DSN=https://[key]@[organization].ingest.sentry.io/[project_id]

# Email service (if notifications added later)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@finance.example.com
# SMTP_PASSWORD=[PASSWORD]

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. DATABASE_URL must be a strong, random password
#    Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. SECRET_KEY must be different from local development
#    Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 3. All secrets should be rotated quarterly
#
# 4. Never push this file to git
#    Add to .gitignore: .env .env.* (except .env.example and .env.production)
#
# 5. On production server:
#    - Store in /opt/finance_app/.env
#    - chmod 600 (readable only by owner)
#    - chown finance_app:finance_app
#
# 6. Backup secrets securely:
#    - Encrypted backup (KMS or age)
#    - Separate from code
#    - Access-restricted
